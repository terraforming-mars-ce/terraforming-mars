# Gateway tasks. Run `just` here for proxy recipes, or `just proxy <recipe>` from the repo root.

set shell := ["bash", "-euo", "pipefail", "-c"]

[private]
default:
    @just --list --unsorted

[group('setup')]
[doc('Install proxy dependencies')]
deps:
    bun install

[group('dev')]
[doc('Run the gateway on :4000; OPENMARS_SERVERS picks its servers (default: `just proxy member` on :3001)')]
dev:
    bun run dev

[group('dev')]
[doc('Build the frontend and run the server as the production image does, on :3001, for the dev gateway; not alongside `just dev`, which also uses :3001')]
member:
    {{ just_executable() }} --justfile {{ source_directory() }}/../justfile frontend build
    {{ just_executable() }} --justfile {{ source_directory() }}/../justfile backend serve

[group('check')]
[doc('Fail if any source file is not oxfmt-formatted')]
format-check:
    bun run format

[group('check')]
[doc('Run oxlint')]
lint:
    bun run lint

[group('check')]
[doc('Type-check the loader and scripts')]
typecheck:
    bun run typecheck

[group('check')]
[doc('Run the loader tests')]
test:
    bun run test

[group('check')]
[doc('Run format-check, lint, typecheck and tests')]
check: format-check lint typecheck test

[group('fix')]
[doc('Format source with oxfmt')]
format:
    bun run format:write

[group('build')]
[doc('Build the gateway to dist/')]
build:
    bun run build

[group('build')]
[doc('Remove build output')]
clean:
    rm -rf dist
